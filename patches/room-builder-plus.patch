+	/**
+	 * Puts lifted items and walls back where they were picked up. Safe to call any time.
+	 */
+	public void restore() {
+		// the room may have changed (undo, redo, expand), find the inner walls again before the next selection
+		scanDirty = true;
+		if (!lifted)
+			return;
+		lifted = false;
+		if (wLifted)
