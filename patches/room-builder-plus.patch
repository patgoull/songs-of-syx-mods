+	private void pickUp(int mx, int my) {
+		int x1 = Integer.MAX_VALUE;
+		int y1 = Integer.MAX_VALUE;
+		int x2 = Integer.MIN_VALUE;
+		int y2 = Integer.MIN_VALUE;
+		for (int k = 0; k < am; k++) {
+			x1 = Math.min(x1, ox[k]);
+			y1 = Math.min(y1, oy[k]);
+			x2 = Math.max(x2, ox[k]+items[k].width()-1);
+			y2 = Math.max(y2, oy[k]+items[k].height()-1);
+			pit[k] = items[k];
+			px[k] = ox[k];
+			py[k] = oy[k];
+		}
+		for (int k = 0; k < wAm; k++) {
+			x1 = Math.min(x1, wx[k]);
+			y1 = Math.min(y1, wy[k]);
+			x2 = Math.max(x2, wx[k]);
+			y2 = Math.max(y2, wy[k]);
+			pwx[k] = wx[k];
+			pwy[k] = wy[k];
+		}
+		for (int k = 0; k < aAm; k++) {
+			x1 = Math.min(x1, ax[k]);
+			y1 = Math.min(y1, ay[k]);
+			x2 = Math.max(x2, ax[k]);
+			y2 = Math.max(y2, ay[k]);
+			pax[k] = ax[k];
+			pay[k] = ay[k];
+		}
+		for (int k = 0; k < dAm; k++) {
+			pdoorX[k] = doorX[k];
+			pdoorY[k] = doorY[k];
+		}
+		// the selection is held at the tile of it closest to the mouse, so dragging past the items doesn't
+		// leave them far from the cursor
+		anchorX = CLAMP.i(mx, x1, x2);
+		anchorY = CLAMP.i(my, y1, y2);
+		buildGrid();
+
+		wStuck = false;
+		if (!copy) {
+			for (int k = 0; k < am; k++)
+				SETT.ROOMS().fData.itemClear(ox[k]+items[k].firstX(), oy[k]+items[k].firstY(), p.instance);
+			// the walls' spots become room while carried, so items can be dropped there
+			for (int k = 0; k < wAm && !wStuck; k++) {
+				CharSequence s = cantBeRoom(wx[k], wy[k]);
+				if (s != null) {
+					stuck.clear().add(┬ñ┬ñwallStuck).s().add(s);
+					wStuck = true;
+				}
+			}
+			if (!wStuck) {
+				for (int k = 0; k < wAm; k++)
+					p.instance.set(wx[k], wy[k]);
+				wLifted = wAm > 0;
+			}
+			lifted = true;
+			p.resources.updatee();
+		}
+
+		offX = 0;
+		offY = 0;
+		noteUntil = 0;
+		floater.sizeSet(floater.sizeBase());
+		dirty = true;
+	}
+
+	// the floating box is centred on the anchor, big enough for the selection in any direction
+	private void buildGrid() {
+		halfW = 0;
+		halfH = 0;
+		for (int k = 0; k < am; k++) {
+			halfW = Math.max(halfW, Math.max(anchorX-px[k], px[k]+pit[k].width()-1-anchorX));
+			halfH = Math.max(halfH, Math.max(anchorY-py[k], py[k]+pit[k].height()-1-anchorY));
+		}
+		for (int k = 0; k < wAm; k++) {
+			halfW = Math.max(halfW, Math.abs(pwx[k]-anchorX));
+			halfH = Math.max(halfH, Math.abs(pwy[k]-anchorY));
+		}
+		for (int k = 0; k < aAm; k++) {
+			halfW = Math.max(halfW, Math.abs(pax[k]-anchorX));
+			halfH = Math.max(halfH, Math.abs(pay[k]-anchorY));
+		}
+		for (int k = 0; k < dAm; k++) {
+			halfW = Math.max(halfW, Math.abs(pdoorX[k]-anchorX));
+			halfH = Math.max(halfH, Math.abs(pdoorY[k]-anchorY));
+		}
+
+		for (int op = ROTATE; op <= SHRINK; op++) {
+			blocked[op] = null;
+			for (int k = 0; k < am && blocked[op] == null; k++)
+				if (turned(pit[k], op) == null)
+					blocked[op] = pit[k];
+		}
+
+		int w = halfW*2+1;
+		int h = halfH*2+1;
+		if (grid.length < w*h) {
+			grid = new int[w*h];
+			gridOverlap = new boolean[w*h];
+			gridFloor = new boolean[w*h];
+			gridDoor = new boolean[w*h];
+		}
+		for (int i = 0; i < w*h; i++) {
+			grid[i] = -1;
+			gridOverlap[i] = false;
+			gridFloor[i] = false;
+			gridDoor[i] = false;
+		}
+		overlaps = false;
+		for (int k = 0; k < am; k++) {
+			FurnisherItem it = pit[k];
+			for (int y = 0; y < it.height(); y++) {
+				for (int x = 0; x < it.width(); x++) {
+					if (it.get(x, y) == null)
+						continue;
+					mark(rx(k)+x + (ry(k)+y)*w, k);
+				}
+			}
+		}
+		for (int k = 0; k < wAm; k++)
+			mark(pwx[k]-anchorX+halfW + (pwy[k]-anchorY+halfH)*w, ITEMS+k);
+		for (int k = 0; k < aAm; k++)
+			gridFloor[pax[k]-anchorX+halfW + (pay[k]-anchorY+halfH)*w] = true;
+		for (int k = 0; k < dAm; k++)
+			gridDoor[pdoorX[k]-anchorX+halfW + (pdoorY[k]-anchorY+halfH)*w] = true;
+	}
+
+	private void mark(int i, int value) {
+		if (grid[i] >= 0) {
+			gridOverlap[i] = true;
+			overlaps = true;
+		}
+		grid[i] = value;
+	}
+
+	// upper left of item k, relative to the floating box
+	private int rx(int k) {
+		return px[k]-anchorX+halfW;
+	}
+
+	private int ry(int k) {
+		return py[k]-anchorY+halfH;
+	}
+
+	private boolean inBox(int rx, int ry) {
+		return rx >= 0 && ry >= 0 && rx < halfW*2+1 && ry < halfH*2+1;
+	}
+
+	private int gridAt(int rx, int ry) {
+		int w = halfW*2+1;
+		if (rx < 0 || ry < 0 || rx >= w || ry >= halfH*2+1)
+			return -1;
+		return grid[rx+ry*w];
+	}
+
+	private int itemAt(int rx, int ry) {
+		int k = gridAt(rx, ry);
+		return k < am ? k : -1;
+	}
+
+	private int wallAt(int rx, int ry) {
+		int k = gridAt(rx, ry);
+		return k >= ITEMS ? k-ITEMS : -1;
+	}
+
+	private boolean floorAt(int rx, int ry) {
+		return inBox(rx, ry) && gridFloor[rx+ry*(halfW*2+1)];
+	}
+
+	private boolean doorAt(int rx, int ry) {
+		return inBox(rx, ry) && gridDoor[rx+ry*(halfW*2+1)];
+	}
+
+	/**
+	 * Rotates (90┬░ clockwise) or mirrors the selection around the anchor. Every item is swapped for the
+	 * variant of its group whose tiles match the turned item. If one has no such variant, nothing changes.
+	 * Walls, and the floor and doorways of a moved room, turn with the selection and keep their size.
+	 */
+	private void transform(int op) {
+		for (int k = 0; k < am; k++) {
+			tmp[k] = turned(pit[k], op);
+			if (tmp[k] == null) {
+				blocked[op] = pit[k];
+				note.clear().add(cant(op));
+				noteUntil = VIEW.renderSecond() + 4;
+				return;
+			}
+		}
+		for (int k = 0; k < am; k++) {
+			int x1 = px[k]-anchorX;
+			int y1 = py[k]-anchorY;
+			int w = pit[k].width();
+			int h = pit[k].height();
+			if (op == GROW || op == SHRINK) {
+				px[k] += w/2 - tmp[k].width()/2;
+				py[k] += h/2 - tmp[k].height()/2;
+			}else if (op == ROTATE) {
+				px[k] = anchorX-(y1+h-1);
+				py[k] = anchorY+x1;
+			}else if (op == FLIP_X) {
+				px[k] = anchorX-(x1+w-1);
+			}else {
+				py[k] = anchorY-(y1+h-1);
+			}
+			pit[k] = tmp[k];
+		}
+		turn(pwx, pwy, wAm, op);
+		turn(pax, pay, aAm, op);
+		turn(pdoorX, pdoorY, dAm, op);
+		noteUntil = 0;
+		buildGrid();
+		dirty = true;
+	}
+
+	// turns single tiles around the anchor
+	private void turn(int[] xs, int[] ys, int n, int op) {
+		for (int k = 0; k < n; k++) {
+			int x1 = xs[k]-anchorX;
+			int y1 = ys[k]-anchorY;
+			if (op == ROTATE) {
+				xs[k] = anchorX-y1;
+				ys[k] = anchorY+x1;
+			}else if (op == FLIP_X) {
+				xs[k] = anchorX-x1;
+			}else if (op == FLIP_Y) {
+				ys[k] = anchorY-y1;
+			}
+		}
+	}
+
+	private static FurnisherItem turned(FurnisherItem it, int op) {
+		FurnisherItemGroup g = it.group;
+		if (op == GROW || op == SHRINK) {
+			int s = it.variation() + (op == GROW ? 1 : -1);
+			return s >= 0 && s < g.size() ? g.item(s, it.rotation) : null;
+		}
+		int n = g.rotations();
+		int r = it.rotation;
+		// rotation i is the first variant turned i times clockwise. Try the variant the turn should give first,
+		// so items whose tiles look the same either way (1x1, symmetric) still turn to face the right way
+		int a = ((-r) % n + n) % n;
+		int b = ((2-r) % n + n) % n;
+		int[] tries = op == ROTATE ? new int[] {(r+1) % n} : op == FLIP_X ? new int[] {a, b} : new int[] {b, a};
+		for (int t : tries) {
+			FurnisherItem c = g.item(it.variation(), t);
+			if (matches(it, c, op))
+				return c;
+		}
+		for (int t = 0; t < n; t++) {
+			FurnisherItem c = g.item(it.variation(), t);
+			if (matches(it, c, op))
+				return c;
+		}
+		return null;
+	}
+
+	private static boolean matches(FurnisherItem it, FurnisherItem c, int op) {
+		int w = it.width();
+		int h = it.height();
+		if (op == ROTATE ? (c.width() != h || c.height() != w) : (c.width() != w || c.height() != h))
+			return false;
+		for (int y = 0; y < h; y++) {
+			for (int x = 0; x < w; x++) {
+				int cx = op == ROTATE ? h-1-y : op == FLIP_X ? w-1-x : x;
+				int cy = op == ROTATE ? x : op == FLIP_Y ? h-1-y : y;
+				if (c.get(cx, cy) != it.get(x, y))
+					return false;
+			}
+		}
+		return true;
+	}
+
+	private boolean unchanged() {
+		if (offX != 0 || offY != 0)
+			return false;
+		for (int k = 0; k < am; k++)
+			if (pit[k] != items[k] || px[k] != ox[k] || py[k] != oy[k])
+				return false;
+		for (int k = 0; k < wAm; k++)
+			if (pwx[k] != wx[k] || pwy[k] != wy[k])
+				return false;
+		for (int k = 0; k < aAm; k++)
+			if (pax[k] != ax[k] || pay[k] != ay[k])
+				return false;
+		return true;
+	}
+
+	private CharSequence problem() {
+		if (!dirty)
+			return problem;
+		dirty = false;
+		problem = null;
+
+		if (overlaps) {
+			problem = ┬ñ┬ñoverlap;
+			return problem;
+		}
+
+		if (room) {
+			problem = roomProblem();
+			return problem;
+		}
+
+		if (!copy && wStuck) {
+			problem = stuck;
+			return problem;
+		}
+
+		if (copy) {
+			for (int i = 0; i < groupAm.length; i++)
+				groupAm[i] = 0;
+			for (int k = 0; k < am; k++) {
+				FurnisherItemGroup g = pit[k].group;
+				groupAm[g.index()]++;
+				if (p.resources.groups(g) + groupAm[g.index()] > g.max) {
+					problem = ┬ñ┬ñmaxReached;
+					return problem;
+				}
+			}
+		}
+
+		for (int k = 0; k < wAm; k++) {
+			CharSequence s = wallProblem(pwx[k]+offX, pwy[k]+offY);
+			if (s != null) {
+				problem = s;
+				return problem;
+			}
+		}
+
+		for (int k = 0; k < am; k++) {
+			CharSequence s = p.placability.itemProblem(px[k]+offX, py[k]+offY, pit[k].group, pit[k], p.instance);
+			if (s != null) {
+				problem = s;
+				return problem;
+			}
+		}
+		return problem;
+	}
+
+	// the new floor must be able to become room, the items must fit on it and the move must fit in one history step
+	private CharSequence roomProblem() {
+		if (tooMany)
+			return ┬ñ┬ñtooMany;
+		int added = 0;
+		for (int k = 0; k < aAm; k++) {
+			int x = pax[k]+offX;
+			int y = pay[k]+offY;
+			if (p.instance.is(x, y))
+				continue;
+			added++;
+			CharSequence s = cantBeRoom(x, y);
+			if (s != null)
+				return s;
+		}
+		// the room leaves as many tiles as it gains, each item and doorway is removed and placed
+		if (2*(added + am + dAm) > HISTORY)
+			return ┬ñ┬ñtooFar;
+		for (int k = 0; k < am; k++) {
+			CharSequence s = p.placability.itemProblem(px[k]+offX, py[k]+offY, pit[k].group, pit[k], ghost);
+			if (s != null)
+				return s;
+		}
+		return null;
+	}
+
+	private void drop() {
+
+		if (!copy && unchanged()) {
+			restore();
+			pending = selector;
+			return;
+		}
+
+		if (room) {
+			dropRoom();
+			return;
+		}
+
+		MapDataF d = SETT.ROOMS().fData;
+
+		if (!copy)
+			for (int k = 0; k < am; k++)
+				if (built[k])
+					setBuilt(k, 0);
+
+		// walls first, so the items are checked next to them
+		CharSequence fail = null;
+		int cut = 0;
+		for (; cut < wAm; cut++) {
+			int x = pwx[cut]+offX;
+			int y = pwy[cut]+offY;
+			fail = wallProblem(x, y);
+			if (fail != null)
+				break;
+			wData[cut] = SETT.ROOMS().data.get(x, y);
+			p.instance.clear(x, y);
+		}
+
+		int placed = 0;
+		if (fail == null) {
+			for (; placed < am; placed++) {
+				FurnisherItem it = pit[placed];
+				int x = px[placed]+offX;
+				int y = py[placed]+offY;
+				fail = fitsNow(x, y, it);
+				if (fail != null)
+					break;
+				d.itemSet(x, y, it, p.instance);
+				p.resources.updatee();
+			}
+		}
+
+		if (fail != null) {
+			for (int k = 0; k < placed; k++)
+				d.itemClear(px[k]+offX+pit[k].firstX(), py[k]+offY+pit[k].firstY(), p.instance);
+			for (int k = 0; k < cut; k++) {
+				int x = pwx[k]+offX;
+				int y = pwy[k]+offY;
+				p.instance.set(x, y);
+				SETT.ROOMS().data.set(p.instance, x, y, wData[k]);
+			}
+			if (!copy)
+				for (int k = 0; k < am; k++)
+					if (built[k])
+						setBuilt(k, 1);
+			p.resources.updatee();
+			dirty = false;
+			problem = fail;
+			return;
+		}
+
+		// what the area placer does when it shrinks or expands the room
+		for (int k = 0; k < wAm; k++)
+			if (ConstructionData.dFloored.is(wData[k], 1))
+				p.resources.removeTile(pwx[k]+offX, pwy[k]+offY);
+		if (wLifted)
+			for (int k = 0; k < wAm; k++)
+				if (p.instance.is(wx[k], wy[k]))
+					SETT.JOBS().clearer.set(wx[k], wy[k]);
+		nAm = 0;
+		for (int k = 0; k < wAm; k++)
+			validateItems(pwx[k]+offX, pwy[k]+offY);
+
+		// undo goes newest first: the dropped items, the new walls, the old walls, then the removed items come back
+		if (!copy) {
+			for (int k = 0; k < am; k++)
+				p.history.placeItem(items[k], ox[k], oy[k], -1);
+			for (int k = 0; k < am; k++)
+				if (built[k])
+					p.resources.removeItem(ox[k], oy[k], items[k]);
+		}
+		for (int k = 0; k < nAm; k++)
+			p.history.placeItem(nIt[k], nx[k], ny[k], -1);
+		if (wLifted)
+			for (int k = 0; k < wAm; k++)
+				p.history.placeEmbryo(wx[k], wy[k], 1);
+		for (int k = 0; k < wAm; k++)
+			p.history.placeEmbryo(pwx[k]+offX, pwy[k]+offY, -1);
+		for (int k = 0; k < am; k++)
+			p.history.placeItem(pit[k], px[k]+offX, py[k]+offY, 1);
+		p.resources.updatee();
+		scanDirty = true;
+
+		if (copy) {
+			dirty = true;
+		}else {
+			lifted = false;
+			wLifted = false;
+			am = 0;
+			wAm = 0;
+			pending = selector;
+		}
+	}
+
+	// moves the floor, the doorways and the items, all checked by roomProblem against the floor where it's dropped
+	private void dropRoom() {
+		MapDataF d = SETT.ROOMS().fData;
+		for (int k = 0; k < am; k++)
+			if (built[k])
+				setBuilt(k, 0);
+
+		// doorways come off while the floor is where they were, and are set again around the new floor
+		for (int k = 0; k < dAm; k++)
+			dOff[k] = p.door.removeWithoutHistory(doorX[k], doorY[k]);
+
+		// the new floor first, so the room is never empty. Floor that stays keeps what's built on it
+		for (int k = 0; k < aAm; k++) {
+			int x = pax[k]+offX;
+			int y = pay[k]+offY;
+			aNew[k] = !p.instance.is(x, y);
+			if (aNew[k]) {
+				// what the area placer does when it expands the room
+				SETT.JOBS().clearer.set(x, y);
+				p.instance.set(x, y);
+				SETT.ROOMS().data.set(p.instance, x, y, 0);
+			}
+		}
+		for (int k = 0; k < aAm; k++) {
+			int x = ax[k];
+			int y = ay[k];
+			aGone[k] = !ghost.is(x, y);
+			if (!aGone[k])
+				continue;
+			// and when it shrinks it
+			if (ConstructionData.dFloored.is(x, y, 1)) {
+				p.resources.removeTile(x, y);
+				SETT.FLOOR().clearer.clear(x, y);
+			}
+			SETT.MAINTENANCE().isser.is(x, y);
+			p.instance.clear(x, y);
+		}
+
+		for (int k = 0; k < dAm; k++)
+			dOn[k] = p.door.placeWithoutHistory(pdoorX[k]+offX, pdoorY[k]+offY);
+
+		for (int k = 0; k < am; k++) {
+			int x = px[k]+offX;
+			int y = py[k]+offY;
+			dropOk[k] = fitsNow(x, y, pit[k]) == null;
+			if (dropOk[k]) {
+				d.itemSet(x, y, pit[k], p.instance);
+				p.resources.updatee();
+			}else {
+				// shouldn't happen, it was checked. It's left out, an undo brings it back
+				LOG.err("room mover: " + pit[k].group.name() + " doesn't fit at " + x + " " + y);
+			}
+		}
+
+		// undo goes newest first: the dropped items, the new doorways, the floor, the old doorways, then the
+		// items come back where they were
+		for (int k = 0; k < am; k++)
+			p.history.placeItem(items[k], ox[k], oy[k], -1);
+		for (int k = 0; k < am; k++)
+			if (built[k])
+				p.resources.removeItem(ox[k], oy[k], items[k]);
+		for (int k = 0; k < dAm; k++)
+			if (dOff[k])
+				p.history.placeDoor(doorX[k], doorY[k], -1);
+		for (int k = 0; k < aAm; k++)
+			if (aNew[k])
+				p.history.placeEmbryo(pax[k]+offX, pay[k]+offY, 1);
+		for (int k = 0; k < aAm; k++)
+			if (aGone[k])
+				p.history.placeEmbryo(ax[k], ay[k], -1);
+		for (int k = 0; k < dAm; k++)
+			if (dOn[k])
+				p.history.placeDoor(pdoorX[k]+offX, pdoorY[k]+offY, 1);
+		for (int k = 0; k < am; k++)
+			if (dropOk[k])
+				p.history.placeItem(pit[k], px[k]+offX, py[k]+offY, 1);
+		p.resources.updatee();
+		scanDirty = true;
+		lifted = false;
+		clearSelection();
+		pending = selector;
+	}
+
+	// items around a new wall that don't fit any more are removed, like the area placer does
+	private void validateItems(int tx, int ty) {
+		MapDataF d = SETT.ROOMS().fData;
+		for (int i = 0; i < DIR.ALL.size(); i++) {
+			DIR dir = DIR.ALL.get(i);
+			int dx = tx+dir.x();
+			int dy = ty+dir.y();
+			if (!p.instance.is(dx, dy))
+				continue;
+			FurnisherItem it = d.item.get(dx, dy);
+			if (it == null)
+				continue;
+			COORDINATE c = d.itemX1Y1(dx, dy, Coo.TMP);
+			int x1 = c.x();
+			int y1 = c.y();
+			if (dropped(it, x1, y1))
+				continue;
+			boolean constructed = ConstructionData.dConstructed.is(dx, dy, 1);
+			d.itemClear(dx, dy, p.instance);
+			if (fitsNow(x1, y1, it) == null) {
+				d.itemSet(x1, y1, it, p.instance);
+				if (constructed)
+					for (int y = 0; y < it.height(); y++)
+						for (int x = 0; x < it.width(); x++)
+							if (it.get(x, y) != null)
+								ConstructionData.dConstructed.set(p.instance, x1+x, y1+y, 1);
+				continue;
+			}
+			if (nAm < MAX) {
+				nIt[nAm] = it;
+				nx[nAm] = x1;
+				ny[nAm] = y1;
+				nAm++;
+			}else {
+				p.history.placeItem(it, x1, y1, -1);
+			}
+			if (constructed)
+				p.resources.removeItem(x1, y1, it);
+		}
+	}
+
+	// the dropped items were checked against the new walls already
+	private boolean dropped(FurnisherItem it, int x1, int y1) {
+		for (int k = 0; k < am; k++)
+			if (pit[k] == it && px[k]+offX == x1 && py[k]+offY == y1)
+				return true;
+		return false;
+	}
+
+	private void setBuilt(int k, int value) {
+		FurnisherItem it = items[k];
+		for (int y = 0; y < it.height(); y++)
+			for (int x = 0; x < it.width(); x++)
+				if (it.get(x, y) != null)
+					ConstructionData.dConstructed.set(p.instance, ox[k]+x, oy[k]+y, value);
+	}
