+	private boolean fits(int x1, int y1, FurnisherItem it) {
+		for (int y = 0; y < it.height(); y++) {
+			for (int x = 0; x < it.width(); x++) {
+				if (it.get(x, y) == null)
+					continue;
+				if (!p.instance.is(x1+x, y1+y) || SETT.ROOMS().fData.tile.is(x1+x, y1+y))
+					return false;
+			}
+		}
+		return true;
+	}
