+		CharSequence s = op == ROTATE ? ┬ñ┬ñcantRotate : op == GROW ? ┬ñ┬ñcantGrow : op == SHRINK ? ┬ñ┬ñcantShrink : ┬ñ┬ñcantFlip;
+		return reason.clear().add(s).s().add(blocked[op].group.name());
