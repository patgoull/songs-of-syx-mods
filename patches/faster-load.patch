+		new CORE.GlJob() {
+			@Override
+			public void doJob() {
+				for (int i = 0; i < x1.length; i++)
+					texture.uploadPixels(x1[i], width, y1[i], size/(width*4), drawBuff.slice(i*size, size));
+			}
+		}.perform();
+	}
